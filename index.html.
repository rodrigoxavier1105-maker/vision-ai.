
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VISION AI</title>
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js"></script>
<style>
*{box-sizing:border-box}
body{margin:0;background:#080b10;color:#fff;font-family:Arial,sans-serif;padding:22px}
header{font-size:22px;font-weight:bold;letter-spacing:3px}
header span{color:#00e5a0}
main{max-width:750px;margin:50px auto}
h1{font-size:36px;margin-bottom:8px}
p{color:#929ba8}
.screen{position:relative;background:#111923;border:1px solid #263342;border-radius:16px;overflow:hidden;margin-top:25px}
video,canvas{width:100%;display:block;transform:scaleX(-1)}
canvas{position:absolute;inset:0}
button{width:100%;padding:17px;background:#00e5a0;color:#00150e;border:0;border-radius:10px;font-weight:bold;margin-top:18px;font-size:15px}
#status{font-size:13px;margin-top:15px}
</style>
</head>
<body>
<header>VISION <span>AI</span></header>
<main>
<h1>Visão computacional.</h1>
<p>Reconhecimento inteligente de movimentos em tempo real.</p>
<div class="screen">
<video id="video" playsinline></video>
<canvas id="canvas"></canvas>
</div>
<button id="start">ATIVAR CÂMERA</button>
<div id="status">Sistema aguardando inicialização.</div>
</main>
<script>
const video=document.getElementById("video");
const canvas=document.getElementById("canvas");
const ctx=canvas.getContext("2d");
const status=document.getElementById("status");
const start=document.getElementById("start");

function draw(results){
canvas.width=video.videoWidth;
canvas.height=video.videoHeight;
ctx.clearRect(0,0,canvas.width,canvas.height);
if(results.multiHandLandmarks){
results.multiHandLandmarks.forEach(hand=>{
ctx.strokeStyle="#00e5a0";
ctx.lineWidth=4;
const links=[[0,1],[1,2],[2,3],[3,4],[0,5],[5,6],[6,7],[7,8],[5,9],[9,10],[10,11],[11,12],[9,13],[13,14],[14,15],[15,16],[13,17],[17,18],[18,19],[19,20],[0,17]];
links.forEach(([a,b])=>{
ctx.beginPath();
ctx.moveTo(hand[a].x*canvas.width,hand[a].y*canvas.height);
ctx.lineTo(hand[b].x*canvas.width,hand[b].y*canvas.height);
ctx.stroke();
});
hand.forEach(point=>{
ctx.beginPath();
ctx.arc(point.x*canvas.width,point.y*canvas.height,5,0,Math.PI*2);
ctx.fillStyle="#ffffff";
ctx.fill();
ctx.strokeStyle="#00e5a0";
ctx.lineWidth=2;
ctx.stroke();
});
});
status.textContent="Mãos detectadas: "+results.multiHandLandmarks.length;
}else{
status.textContent="Procurando mãos...";
}
}

start.onclick=async()=>{
try{
status.textContent="Solicitando acesso à câmera...";
const stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:"environment"},audio:false});
video.srcObject=stream;
await video.play();
const hands=new Hands({locateFile:file=>"https://cdn.jsdelivr.net/npm/@mediapipe/hands/"+file});
hands.setOptions({maxNumHands:2,modelComplexity:1,minDetectionConfidence:0.6,minTrackingConfidence:0.6});
hands.onResults(draw);
const camera=new Camera(video,{onFrame:async()=>{await hands.send({image:video});},width:640,height:480});
camera.start();
start.textContent="CÂMERA ATIVA";
status.textContent="Inteligência artificial inicializada.";
}catch(error){
status.textContent="Erro: "+error.name+" — "+error.message;
}
};
</script>
</body>
</html>

